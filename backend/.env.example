# "production" hace obligatorios los secretos de abajo y rechaza los valores
# de desarrollo: la API no arranca antes que arrancar insegura. El compose de
# producción (deploy/) ya lo fuerza; acá queda en development.
ENV=development

# Base de datos: es la tuya. Telar solo necesita permisos de esquema.
# - Desarrollo: la ignora, docker-compose.yml usa su propio Postgres.
# - Supabase: Project Settings > Database > Connection string > "Session
#   pooler" (puerto 5432). Ej.:
#   postgresql://postgres.<ref>:<password>@aws-0-<región>.pooler.supabase.com:5432/postgres?sslmode=require
# - Postgres propio: postgresql://usuario:password@host:5432/telar
DATABASE_URL=postgresql://telar:telar@localhost:5432/telar
# Conexiones por proceso. El pooler de Supabase tiene un tope según el plan;
# 10 es seguro para empezar (ver Database > Connection pooling).
DB_POOL_MAX_SIZE=10

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración)
META_APP_SECRET=
META_VERIFY_TOKEN=cambia-esto-por-algo-aleatorio
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# Cifrado de tokens guardados en base de datos.
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Firma de los tokens de sesión de usuarios (login del panel, no de WhatsApp).
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Origen exacto del frontend desplegado (CORS solo acepta uno, no "*").
# En dev es http://localhost:5173 (valor por defecto, no hace falta ponerlo).
FRONTEND_ORIGIN=https://tu-panel.pages.dev

# Segundos de espera para agrupar mensajes en ráfaga
DEBOUNCE_SECONDS=5

# Modelo por defecto. Formato "proveedor:modelo".
DEFAULT_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Bases de conocimiento (opcional): requiere pip install "telar[openai]"
# y esta clave, aunque DEFAULT_MODEL use otro proveedor para el chat.
OPENAI_API_KEY=

LOG_LEVEL=INFO

# Cloudflare Tunnel: obligatorio en producción (deploy/), opcional en dev.
CLOUDFLARE_TUNNEL_TOKEN=
# Versión de la imagen cloudflared (fijarla evita sorpresas en un redeploy).
CLOUDFLARED_VERSION=latest

# Header con la IP real del cliente detrás de un proxy. El compose de
# producción ya pone CF-Connecting-IP; dejalo vacío si la API es accesible
# sin pasar por el proxy (cualquiera podría inventar el header).
TRUSTED_CLIENT_IP_HEADER=
